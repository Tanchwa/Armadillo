{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "$ref": "#/definitions/stringMap" },
        "matchExpressions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 0 },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedHosts": { "type": "string", "minLength": 1 },
            "syncInterval": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "objectSelector": { "$ref": "#/definitions/labelSelector" },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] }
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "enum": ["helm", "certManager"] },
            "duration": { "type": "integer", "minimum": 1 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" }
          }
        }
      }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "gatePort": { "$ref": "#/definitions/port" },
        "profileDir": { "type": "string", "pattern": "^/" },
        "securityfsDir": { "type": "string", "pattern": "^/" },
        "nodeRestriction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "interval": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsNamespaceSelector": { "$ref": "#/definitions/labelSelector" }
      }
    }
  }
}
